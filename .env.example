# ZenkAI environment variables — copy to .env and adjust as needed.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:12b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION=zenkai_paragraphs

DUCKDB_PATH=./data/corpus.duckdb

PIPER_BINARY=./bin/piper
PIPER_MODEL=./data/piper_models/de_DE-thorsten-high.onnx

WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
