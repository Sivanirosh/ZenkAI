# Lesekamerad environment variables — copy to .env and adjust as needed.

OLLAMA_BASE_URL=http://localhost:11434
# Mira default is Gemma 4 e4b (4B-class edge model). Swap to gemma4:26b on
# a flagship machine for richer reasoning, or any other installed Ollama
# model — the AI Settings panel hot-swaps at runtime.
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION=lesekamerad_paragraphs

DUCKDB_PATH=./data/corpus.duckdb

PIPER_BINARY=./bin/piper
PIPER_MODEL=./data/piper_models/de_DE-thorsten-high.onnx

WHISPER_MODEL_SIZE=base
# cpu  — always use CPU (safe default)
# auto — auto-detect CUDA; falls back to CPU if unavailable
WHISPER_DEVICE=auto

# STT chain prefers faster-whisper by default. Set to 1 to also try the
# active LLM provider's audio multimodal endpoint as a fallback (only useful
# when a real audio-capable Gemma 4 build is installed in Ollama — most
# Gemma 4 builds today are text+vision only).
LINGUAMATE_GEMMA_AUDIO=0

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
